PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/postmark
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:3000

# AI provider. Get a free Gemini key at https://aistudio.google.com (Get API key)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-flash-latest
# Only for LLM_PROVIDER=openai (e.g. Groq): LLM_BASE_URL=https://api.groq.com/openai/v1
